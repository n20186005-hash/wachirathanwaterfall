---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import th from '../../../i18n/th.json';
import { guides } from '../../../data/guides';
import { detailFor } from '../../../data/guideDetails';
import { placeProfiles } from '../../../data/placeProfiles';
import { siteConfig } from '../../../config';

export const prerender = true;

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const extra = detailFor(guide);
const profile = placeProfiles[guide.slug];
const canonical = `${siteConfig.siteUrl}/th/guides/${guide.slug}/`;
const mapUrl = guide.mapQuery
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(guide.mapQuery + ', Chiang Mai, Thailand')}`
  : siteConfig.mapsUrl;
const photo = extra.photos?.[0];
const imageSrc = photo ? `/nearby/${photo}?v=20261112` : '/gallery/wachirathan-waterfall-3.jpg';
const imageCaption = photo ? `ภาพ${guide.title} — ${guide.slug === 'hmong-market' ? 'Wongnai (ภาพจากผู้เยี่ยมชม)' : 'Wikimedia Commons'}` : 'ภาพน้ำตกวชิรธารประกอบการวางแผนเที่ยวดอยอินทนนท์ — ไม่ใช่ภาพของสถานที่อื่น';
const faq = [
  { q: `ควรจัดทริป${guide.title}ร่วมกับน้ำตกวชิรธารอย่างไร?`, a: guide.route },
  { q: `มีข้อควรระวังอะไรสำหรับ${guide.title}?`, a: guide.advice },
];
const jsonLd = [
  { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
    { '@type':'ListItem',position:1,name:'หน้าแรก',item:`${siteConfig.siteUrl}/th/` },
    { '@type':'ListItem',position:2,name:'คู่มือท่องเที่ยว',item:`${siteConfig.siteUrl}/th/guides/` },
    { '@type':'ListItem',position:3,name:guide.title,item:canonical },
  ] },
  { '@context':'https://schema.org','@type':'Article',headline:`${guide.title} | คู่มือเที่ยวดอยอินทนนท์`,description:guide.intro,inLanguage:'th-TH',mainEntityOfPage:canonical,publisher:{'@type':'Organization',name:'Wachirathan Waterfall Guide'} },
  { '@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map((f)=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}})) },
];
const related = guides.filter((g) => g.slug !== guide.slug && g.kind === guide.kind).slice(0, 5);
const nearby = guides.filter((g) => g.kind === 'nearby' && g.slug !== guide.slug);
---
<BaseLayout lang="th" title={`${guide.title} | คู่มือเที่ยวดอยอินทนนท์`} description={guide.intro} messages={th} canonicalUrl={canonical} homeAlternates={false}>
  <Header lang="th" messages={th} />
  <main class="max-w-5xl mx-auto px-5 pt-28 pb-16">
    <nav class="text-sm text-ink/70 mb-7" aria-label="Breadcrumb"><a href="/th/" class="text-teak underline">หน้าแรก</a> / <a href="/th/guides/" class="text-teak underline">คู่มือท่องเที่ยว</a> / {guide.title}</nav>
    <header class="rounded-3xl bg-teak text-ivory p-7 md:p-12 mb-10">
      <span class="text-goldBright text-sm">{guide.kind === 'nearby' ? 'สถานที่เที่ยวใกล้เคียง' : 'วางแผนเดินทาง'}</span>
      <h1 class="font-display text-3xl md:text-5xl mt-3 mb-5">{guide.title}</h1>
      <p class="text-lg leading-relaxed text-ivory/85 max-w-3xl">{guide.intro}</p>
      <div class="flex flex-wrap gap-3 mt-5 text-sm text-ivory/90"><span class="border border-gold/40 rounded-full px-4 py-2">{profile ? 'คะแนน Google Maps: ดูข้อมูลล่าสุดที่แผนที่' : 'คู่มือวางแผนเที่ยว'}</span><span class="border border-gold/40 rounded-full px-4 py-2">เวลาเปิด: {profile ? 'ขึ้นกับจุดหมาย' : 'ตามสถานที่ที่เลือก'}</span><span class="border border-gold/40 rounded-full px-4 py-2">{profile?.duration ?? 'ปรับตามกิจกรรม'}</span></div>
      <div class="flex flex-wrap gap-3 mt-7"><a href={mapUrl} target="_blank" rel="noopener noreferrer" class="bg-gold rounded-full text-teak px-5 py-2 font-semibold">ดูตำแหน่งบน Google Maps ↗</a><a href="/th/guides/" class="border border-gold/50 rounded-full px-5 py-2">ดูคู่มือทั้งหมด</a></div>
    </header>
    <section class="mb-11" aria-labelledby="explore-guide"><h2 id="explore-guide" class="font-display text-3xl text-teak mb-4">สำรวจ{guide.title}</h2><p class="text-ink/85 leading-loose">{guide.detail}</p>{profile && <p class="mt-4 text-ink/85 leading-loose">ลักษณะเฉพาะของสถานที่: {profile.character} การวางเวลาให้เหมาะกับจุดหมายนี้จะช่วยให้สังเกตภูมิทัศน์และเรียนรู้เรื่องราวของพื้นที่ได้มากกว่าการแวะถ่ายภาพเพียงอย่างเดียว</p>}</section>
    <section class="mb-11 rounded-2xl border-l-4 border-gold bg-white/60 p-7 md:p-9" aria-labelledby="about-management">
      <h2 id="about-management" class="font-display text-2xl text-teak mb-4">เกี่ยวกับ{guide.title}และผู้ดูแลพื้นที่</h2>
      <p class="leading-loose text-ink/85">{extra.manager}</p>
      <p class="leading-loose text-ink/85 mt-4">บทบาทของผู้ดูแลพื้นที่คือกำหนดข้อปฏิบัติ การอนุรักษ์ และการจัดการผู้มาเยือน ข้อมูลเวลาเปิด เส้นทาง และเงื่อนไขเข้าชมให้ยึดประกาศของหน่วยงานที่รับผิดชอบสถานที่นั้นในวันที่เดินทาง</p>
    </section>
    <section class="grid md:grid-cols-2 gap-6 mb-12"><div class="rounded-2xl bg-white/60 p-7 border border-gold/30"><h2 class="font-display text-2xl text-teak mb-4">คำแนะนำการเที่ยวชม</h2><p class="leading-loose text-ink/85">{profile?.visit ?? guide.route}</p></div><div class="rounded-2xl bg-white/60 p-7 border border-gold/30"><h2 class="font-display text-2xl text-teak mb-4">จุดเด่นของสถานที่</h2><p class="leading-loose text-ink/85">{profile?.character ?? extra.heritage}</p></div></section>
    <section class="grid md:grid-cols-2 gap-8 mb-12 items-center">
      <div><h2 class="font-display text-2xl text-teak mb-4">ทำความรู้จัก{guide.title}</h2><p class="text-ink/85 leading-loose">{guide.detail}</p></div>
      <figure><img src={imageSrc} alt={photo ? `ภาพสถานที่ ${guide.title}` : 'ภาพน้ำตกวชิรธารประกอบการวางแผน'} loading="lazy" class="w-full aspect-[4/3] object-cover rounded-2xl"/><figcaption class="text-sm text-ink/60 mt-2">{imageCaption}</figcaption></figure>
    </section>
    <section class="mb-12 grid md:grid-cols-2 gap-7">
      <div><h2 class="font-display text-2xl text-teak mb-4">ภูมิหลังและลักษณะเด่น</h2><p class="text-ink/85 leading-loose">{extra.heritage}</p></div>
      <div><h2 class="font-display text-2xl text-teak mb-4">จุดสังเกตและมุมถ่ายภาพ</h2><p class="text-ink/85 leading-loose">{extra.observe}</p><p class="mt-3 text-ink/80 leading-loose">เลือกแสงธรรมชาติและหาจุดยืนมั่นคง หากมีหมอกหรือฝนหนักให้เน้นชมวิวจากจุดที่เจ้าหน้าที่เปิดเท่านั้น</p></div>
    </section>
    {profile && <section class="mb-12"><h2 class="font-display text-2xl text-teak mb-5">ข้อมูลสำคัญก่อนออกเดินทาง</h2><dl class="grid md:grid-cols-2 gap-3">{[['ชื่อสถานที่',guide.title],['ที่ตั้ง / แนวทางระบุที่อยู่',profile.area],['ลักษณะพื้นที่',profile.character],['เวลาที่ควรเผื่อ',profile.duration],['การเปิดให้เข้าชม',profile.hours],['ค่าเข้าชมและกิจกรรม',profile.fee]].map(([k,v])=><div class="rounded-xl bg-white/70 border border-gold/30 p-5"><dt class="font-semibold text-teak">{k}</dt><dd class="mt-2 leading-relaxed text-ink/80">{v}</dd></div>)}</dl><p class="text-sm text-ink/65 mt-3">ที่ตั้งด้านบนระบุจุดหมายและเส้นทางเข้าถึง ไม่ใช่เลขที่ถนนที่ยังไม่ได้รับการยืนยัน โปรดเปิดชื่อสถานที่บน Google Maps ก่อนนำทาง</p></section>}
    <section class="grid md:grid-cols-2 gap-7 mb-12"><div><h2 class="font-display text-2xl text-teak mb-3">เวลาทำการและการเข้าเยี่ยมชม</h2><p class="leading-loose text-ink/85">{profile?.hours ?? 'กิจกรรมแต่ละอย่างใช้เวลาไม่เท่ากัน โปรดเช็กช่วงเปิดของสถานที่ที่จะไปตามแผน'}</p></div><div><h2 class="font-display text-2xl text-teak mb-3">ค่าเข้าและค่าบริการ</h2><p class="leading-loose text-ink/85">{profile?.fee ?? 'ค่าเข้าอุทยานและค่าบริการเฉพาะกิจกรรมอาจแยกกัน ตรวจประกาศก่อนออกเดินทาง'}</p></div></section>
    <section class="mb-12"><h2 class="font-display text-2xl text-teak mb-4">การเดินทางด้วยรถยนต์และการเดินทางสาธารณะ</h2><p class="leading-loose text-ink/85">{profile?.transport ?? guide.route}</p><p class="leading-loose mt-3 text-ink/80">หากไม่ได้ขับรถเอง ให้ตกลงจุดรับ–ส่งและเที่ยวกลับกับผู้ให้บริการที่จอมทองหรือเชียงใหม่ก่อนขึ้นดอย เพราะจุดแวะหลายแห่งไม่มีบริการรถประจำทางถึงหน้าแหล่งท่องเที่ยว</p></section>
    <section class="grid md:grid-cols-2 gap-6 mb-12">
      <div class="border border-gold/30 bg-white/60 rounded-2xl p-7"><h2 class="font-display text-2xl text-teak mb-4">เส้นทางเที่ยวที่แนะนำ</h2><p class="leading-loose text-ink/85">{guide.route}</p></div>
      <div class="border border-gold/30 bg-white/60 rounded-2xl p-7"><h2 class="font-display text-2xl text-teak mb-4">ข้อควรรู้ก่อนเดินทาง</h2><p class="leading-loose text-ink/85">{guide.advice}</p><p class="mt-3 leading-loose text-ink/80">เวลาเปิด ค่าธรรมเนียม และสภาพทางเดินอาจเปลี่ยนตามประกาศของเจ้าหน้าที่ ควรตรวจสอบก่อนออกเดินทาง</p></div>
    </section>
    <section class="mb-12"><h2 class="font-display text-2xl text-teak mb-5">ลำดับการเที่ยวแบบง่าย</h2><ol class="grid md:grid-cols-3 gap-4">{(profile?.sequence ?? ['ตรวจสภาพอากาศและประกาศอุทยาน','กำหนดเวลาเดินทางและจุดแวะ','เดินตามทางที่เปิดและเผื่อเวลากลับ']).map((step,i)=><li class="rounded-xl bg-gold/10 p-5"><span class="font-display text-2xl text-teak">0{i+1}</span><p class="mt-2 text-ink/85">{step}</p></li>)}</ol></section>
    <section class="mb-12"><h2 class="font-display text-2xl text-teak mb-4">ข้อมูลพื้นฐานสำหรับผู้มาเยือน</h2><dl class="grid md:grid-cols-2 gap-3">{[['ประเภท',guide.kind==='nearby'?'สถานที่เที่ยวรอบดอยอินทนนท์':'คู่มือวางแผนท่องเที่ยว'],['ที่ตั้ง',profile?.area ?? 'น้ำตกวชิรธาร อุทยานแห่งชาติดอยอินทนนท์ อำเภอจอมทอง จังหวัดเชียงใหม่'],['เวลาเปิด',profile?.hours ?? 'ตรวจเวลาของสถานที่จริงและประกาศอุทยาน'],['บัตรเข้าชม',profile?.fee ?? 'สอบถามค่าเข้าพื้นที่/กิจกรรมเพิ่มเติมตามจุดหมาย']].map(([a,b])=><div class="rounded-xl border border-gold/30 p-4"><dt class="font-semibold text-teak">{a}</dt><dd class="text-ink/80 mt-1">{b}</dd></div>)}</dl></section>
    <section class="grid md:grid-cols-2 gap-6 mb-12"><div class="bg-white/60 border border-gold/30 rounded-2xl p-7"><h2 class="font-display text-2xl text-teak mb-3">มุมถ่ายภาพที่แนะนำ</h2><p class="leading-loose text-ink/85">{profile?.photoTip ?? extra.observe}</p></div><div class="bg-white/60 border border-gold/30 rounded-2xl p-7"><h2 class="font-display text-2xl text-teak mb-3">พักที่ไหนระหว่างเที่ยว</h2><p class="leading-loose text-ink/85">{profile?.stay ?? 'หากต้องการเที่ยวหลายจุด ควรเลือกที่พักจากลำดับการเดินทางจริง ทั้งจอมทองและเชียงใหม่มีตัวเลือกที่ต่างกัน'}</p></div></section>
    <section class="mb-12"><h2 class="font-display text-2xl text-teak mb-3">มุมมองของนักท่องเที่ยว</h2><p class="leading-loose text-ink/85">{profile ? `ผู้ที่ชอบ${profile.character}ควรเผื่อเวลา${profile.duration} และตัดสินใจจากสภาพอากาศจริง` : guide.advice} คะแนนและรีวิวของสถานที่นี้ควรเปิดตรวจจาก Google Maps ของสถานที่โดยตรงเพื่อไม่ให้ปะปนกับคะแนนน้ำตกวชิรธาร</p><a href={mapUrl} target="_blank" rel="noopener noreferrer" class="underline text-teak inline-block mt-3">ดูรีวิวล่าสุดของ{guide.title}บนแผนที่ ↗</a></section>
    <section class="mb-12"><h2 class="font-display text-2xl text-teak mb-4">วิธีเดินทางและแผนที่</h2><p class="leading-loose text-ink/85 mb-5">{guide.route}</p><iframe title={`แผนที่ ${guide.title}`} src={`https://www.google.com/maps?q=${encodeURIComponent((guide.mapQuery || 'Wachirathan Waterfall')+', Chiang Mai, Thailand')}&output=embed`} class="w-full h-72 rounded-2xl border border-gold/30" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><a class="inline-block mt-4 text-teak underline" href={mapUrl} target="_blank" rel="noopener noreferrer">เปิดเส้นทางไปยัง{guide.title}ใน Google Maps ↗</a></section>
    <section class="mb-12"><h2 class="font-display text-2xl text-teak mb-5">คำถามที่พบบ่อย</h2><div class="space-y-3">{faq.map((f)=><details class="border border-gold/30 rounded-xl p-5"><summary class="cursor-pointer font-semibold text-teak">{f.q}</summary><p class="mt-3 leading-loose text-ink/80">{f.a}</p></details>)}</div></section>
    <section class="mb-12"><h2 class="font-display text-2xl text-teak mb-4">ข้อมูลการเดินทางและแหล่งอ้างอิง</h2><p class="text-ink/80 mb-4">ดูชื่อสถานที่และตำแหน่งบนแผนที่โดยตรงก่อนนำทาง การเดินทางในอุทยานอาจใช้เวลามากกว่าระยะทางที่เห็นบนแผนที่</p><div class="flex flex-wrap gap-4 text-sm"><a class="underline text-teak" href={mapUrl} target="_blank" rel="noopener noreferrer">Google Maps ของ{guide.title}</a><a class="underline text-teak" href="https://thai.tourismthailand.org/" target="_blank" rel="noopener noreferrer">การท่องเที่ยวแห่งประเทศไทย</a><a class="underline text-teak" href="https://www.dnp.go.th/" target="_blank" rel="noopener noreferrer">กรมอุทยานแห่งชาติ</a></div></section>
    <section class="mb-12"><h2 class="font-display text-2xl text-teak mb-5">สถานที่เที่ยวใกล้เคียงเพิ่มเติม</h2><div class="grid md:grid-cols-3 gap-4">{nearby.slice(0,9).map((item)=><a class="block rounded-xl border border-gold/30 p-5 hover:bg-gold/10" href={`/th/guides/${item.slug}/`}><h3 class="font-semibold text-teak mb-2">{item.title}</h3><p class="text-sm text-ink/70 line-clamp-3">{item.intro}</p></a>)}</div></section>
    <section><h2 class="font-display text-2xl text-teak mb-5">อ่านคู่มือที่เกี่ยวข้อง</h2><div class="grid md:grid-cols-3 gap-4">{related.map((item)=><a class="block rounded-xl border border-gold/30 p-5 hover:bg-gold/10" href={`/th/guides/${item.slug}/`}><h3 class="font-semibold text-teak mb-2">{item.title}</h3><p class="text-sm text-ink/70 line-clamp-3">{item.intro}</p></a>)}</div></section>
  </main>
  <Footer lang="th" messages={th} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
