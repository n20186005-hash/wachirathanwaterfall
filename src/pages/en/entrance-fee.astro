---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import en from '../../i18n/en.json';

const title = 'Wachirathan Waterfall Entrance Fee & Opening Hours | Chiang Mai';
const description = 'Doi Inthanon National Park entrance fees for Wachirathan Waterfall: foreigner and Thai rates, vehicle charges, gate location and opening hours. Updated October 2026.';
const canonical = 'https://wachirathanwaterfall.com/en/entrance-fee/';

const faqs = [
  { q: 'Is there a separate ticket for Wachirathan Waterfall?', a: 'No. Wachirathan Waterfall sits inside Doi Inthanon National Park, so you only pay the national park entrance fee. There is no additional ticket sold just for the waterfall.' },
  { q: 'How much is the entrance fee?', a: 'Foreign visitors pay 300 THB for adults and 150 THB for children. Thai nationals pay 50 THB for adults and 20 THB for children. These are national park rates, shown as of October 2026.' },
  { q: 'Is there a vehicle fee?', a: 'Yes. The entry fee is per person. If you arrive by car, motorbike or tour van, the park charges a separate vehicle access fee in addition to the per-person ticket.' },
  { q: 'What are the opening hours?', a: 'The site is open daily from 06:00 to 17:00. Hours are shown as of October 2026 — please confirm with Doi Inthanon National Park before your visit.' },
  { q: 'Where do I pay, and should I keep the receipt?', a: 'Pay at the Doi Inthanon National Park gate on Highway 1009 (around Km. 21–22). Keep your receipt; rangers may check it at checkpoints inside the park.' }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wachirathanwaterfall.com/en/' },
      { '@type': 'ListItem', position: 2, name: 'Entrance Fee', item: canonical }
    ]},
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
  ]
};
---

<BaseLayout lang="en" title={title} description={description} messages={en}>
  <Header lang="en" messages={en} />
  <main class="mx-auto max-w-3xl px-5 py-12">
    <nav class="text-sm text-ink/60 mb-6" aria-label="Breadcrumb">
      <a href="/en/" class="text-gold hover:underline">Home</a>
      <span class="mx-2">›</span>
      <span class="text-ink/80">Entrance Fee</span>
    </nav>

    <h1 class="font-display text-3xl md:text-4xl text-teak mb-4">Wachirathan Waterfall Entrance Fee &amp; Opening Hours</h1>
    <p class="text-lg text-ink/80 mb-8 leading-relaxed">
      Wachirathan Waterfall is inside <strong>Doi Inthanon National Park</strong>, so the only cost is the national park entrance fee — there is no separate ticket for the waterfall itself. Rates below are shown as of October 2026; confirm with the park before travelling.
    </p>

    <section class="rounded-2xl border border-gold/30 bg-white/50 p-6 mb-8">
      <h2 class="font-display text-xl text-teak mb-4">National park entrance fee</h2>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left border-b border-gold/20 text-ink/70">
            <th class="py-2 pr-3">Visitor</th><th class="py-2">Adult</th><th class="py-2">Child</th>
          </tr>
        </thead>
        <tbody class="text-ink/85">
          <tr class="border-b border-gold/10"><td class="py-2 pr-3">Foreigners</td><td class="py-2">300 THB</td><td class="py-2">150 THB</td></tr>
          <tr class="border-b border-gold/10"><td class="py-2 pr-3">Thai nationals</td><td class="py-2">50 THB</td><td class="py-2">20 THB</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-ink/55 leading-relaxed">The fee is per person. A separate vehicle access fee may apply inside the park if you arrive by car, motorbike or tour van. Thai nationals may receive local resident rates. Confirm current rates with the Department of National Parks (DNP).</p>
    </section>

    <section class="rounded-2xl border border-gold/30 bg-white/50 p-6 mb-8">
      <h2 class="font-display text-xl text-teak mb-4">Opening hours</h2>
      <p class="text-ink/85">Open daily (Monday–Sunday) from <strong>06:00 to 17:00</strong>. The waterfall viewpoint is reached by a short walk from the car park; the gate may stop new entries before 17:00, so arrive with time to spare.</p>
      <p class="mt-3 text-xs text-ink/55 leading-relaxed">Hours shown as of October 2026 — please confirm with Doi Inthanon National Park before visiting.</p>
    </section>

    <section class="mb-8">
      <h2 class="font-display text-xl text-teak mb-4">Where to pay</h2>
      <p class="text-ink/85 leading-relaxed">You pay at the Doi Inthanon National Park gate on Highway 1009 (around Km. 21–22), before the short drive to the waterfall car park. Keep your receipt — rangers may check it at checkpoints inside the park.</p>
    </section>

    <section class="mb-8">
      <h2 class="font-display text-xl text-teak mb-4">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="rounded-xl border border-gold/20 bg-white/40 p-4">
            <summary class="font-medium text-teak cursor-pointer">{f.q}</summary>
            <p class="mt-2 text-sm text-ink/80 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <nav class="flex flex-wrap gap-3 text-sm">
      <a href="/en/#guide" class="rounded-full border border-gold/40 px-4 py-2 text-teak hover:bg-gold/10">← Back to main guide</a>
      <a href="/en/how-to-get-there/" class="rounded-full border border-gold/40 px-4 py-2 text-teak hover:bg-gold/10">How to get there →</a>
      <a href="/en/best-time-to-visit/" class="rounded-full border border-gold/40 px-4 py-2 text-teak hover:bg-gold/10">Best time to visit →</a>
    </nav>
  </main>
  <Footer lang="en" messages={en} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
