---
import { languagesList, type Lang } from '../../i18n/ui';
import { getI18n } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Sources from '../../components/Sources.astro';

export const prerender = true;
export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const { messages } = await getI18n(new URL(`https://x.com/${lang}/`));
---
<BaseLayout lang={lang} title={`${messages.sources.heading} | ${messages.meta.title}`} description={messages.sources.intro} messages={messages}>
  <Header lang={lang} messages={messages} />
  <main class="pt-20">
    <div class="max-w-7xl mx-auto px-5 pt-8"><a class="text-teak underline" href={`/${lang}/`}>← {lang === 'zh' ? '返回首页' : lang === 'th' ? 'กลับหน้าแรก' : 'Back to home'}</a></div>
    <Sources messages={messages} />
  </main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>
