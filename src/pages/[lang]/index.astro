---
// 主页：SSR 渲染（含服务端获取的实时天气）
import { languagesList, defaultLang, type Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Ecosystem from '../../components/Ecosystem.astro';
import History from '../../components/History.astro';
import Weather from '../../components/Weather.astro';
import Guide from '../../components/Guide.astro';
import Facilities from '../../components/Facilities.astro';
import Food from '../../components/Food.astro';
import Seasonal from '../../components/Seasonal.astro';
import Plans from '../../components/Plans.astro';
import Itinerary from '../../components/Itinerary.astro';
import Conservation from '../../components/Conservation.astro';
import Gallery from '../../components/Gallery.astro';
import Reviews from '../../components/Reviews.astro';
import Sources from '../../components/Sources.astro';
import MapSection from '../../components/MapSection.astro';
import Footer from '../../components/Footer.astro';
import { getI18n } from '../../i18n/ui';

const raw = Astro.params.lang as string | undefined;
const lang: Lang = (languagesList as readonly string[]).includes(raw ?? '') ? (raw as Lang) : defaultLang;
const { messages } = await getI18n(new URL(`https://x.com/${lang}/`));
---

<BaseLayout lang={lang} title={messages.meta.title} description={messages.meta.description} messages={messages}>
  <Header lang={lang} messages={messages} />
  <main>
    <Hero lang={lang} messages={messages} />
    <About messages={messages} />
    <Ecosystem messages={messages} />
    <History messages={messages} />
    <Weather lang={lang} messages={messages} />
    <Guide messages={messages} />

    {lang === 'en' && (
      <section class="mx-auto max-w-6xl px-5 py-10">
        <h2 class="font-display text-2xl text-teak mb-6 text-center">In-depth guides</h2>
        <div class="grid gap-5 md:grid-cols-3">
          <a href="/en/entrance-fee/" class="block rounded-2xl border border-gold/30 bg-white/50 p-6 hover:bg-gold/5 transition">
            <h3 class="font-display text-lg text-teak mb-2">Entrance Fee &amp; Opening Hours</h3>
            <p class="text-sm text-ink/70 leading-relaxed">Park fees, foreigner vs Thai rates, vehicle charges and where to pay at the gate.</p>
          </a>
          <a href="/en/how-to-get-there/" class="block rounded-2xl border border-gold/30 bg-white/50 p-6 hover:bg-gold/5 transition">
            <h3 class="font-display text-lg text-teak mb-2">How to Get There</h3>
            <p class="text-sm text-ink/70 leading-relaxed">Distance from Chiang Mai, self-drive, taxi and tour options, parking and the walk in.</p>
          </a>
          <a href="/en/best-time-to-visit/" class="block rounded-2xl border border-gold/30 bg-white/50 p-6 hover:bg-gold/5 transition">
            <h3 class="font-display text-lg text-teak mb-2">Best Time to Visit</h3>
            <p class="text-sm text-ink/70 leading-relaxed">Rainy, cool and hot season compared, plus the best light and how to avoid crowds.</p>
          </a>
        </div>
      </section>
    )}

    <Facilities messages={messages} />
    <Food messages={messages} />
    <Seasonal messages={messages} />
    <Plans messages={messages} />
    <Itinerary messages={messages} />
    <Conservation messages={messages} />
    <Gallery messages={messages} />
    <Reviews messages={messages} />
    <Sources messages={messages} />
    <MapSection lang={lang} messages={messages} />
  </main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>