---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const plans = messages.plans;
---

<section id="plans" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{plans.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{plans.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{plans.lead}</p>

    <div class="mt-10 grid md:grid-cols-3 gap-6">
      {plans.groups.map((g: any) => (
        <div class="rounded-2xl border border-gold/30 bg-white/50 p-6 flex flex-col hover:border-gold hover:shadow-lg transition">
          <div class="text-4xl" aria-hidden="true">{g.tag}</div>
          <h3 class="font-display text-xl text-teak mt-3">{g.title}</h3>
          <p class="mt-2 text-sm text-ink/70 leading-relaxed">{g.desc}</p>

          <ol class="mt-5 space-y-2.5 text-sm text-ink/80 flex-1">
            {g.schedule.map((s: any) => (
              <li class="flex gap-2.5">
                <span class="text-gold font-semibold" aria-hidden="true">▸</span>
                <span>{s}</span>
              </li>
            ))}
          </ol>

          <div class="mt-5 pt-4 border-t border-gold/20 space-y-1.5">
            {g.tips.map((t: any) => (
              <p class="text-xs text-teak flex gap-2">
                <span aria-hidden="true">✓</span>
                <span>{t}</span>
              </p>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>