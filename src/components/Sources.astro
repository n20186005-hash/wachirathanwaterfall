---
import { siteConfig } from '../config';

interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const sources = messages.sources;
const mapsUrl = siteConfig.mapsUrl;
---

<section id="sources" class="py-20 bg-sand text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{sources.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{sources.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{sources.intro}</p>

    <!-- 图片授权 + 图片版权声明 -->
    <div class="mt-10 rounded-2xl border border-gold/30 bg-white/60 p-6">
      <h3 class="font-display text-xl text-teak">{sources.photoTitle}</h3>
      <ul class="mt-4 space-y-2 text-sm text-ink/80">
        {sources.photoItems.map((it) => (
          <li class="flex gap-2">
            <span class="text-gold mt-0.5" aria-hidden="true">•</span>
            <span>
              {it.text}
              {it.url && (
                <>
                  {' '}
                  <a href={it.url} target="_blank" rel="noopener noreferrer" class="text-gold hover:underline">
                    {it.linkLabel || it.url} ↗
                  </a>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>

    <!-- 评价来源（同步自 Google 地图） -->
    <div class="mt-8 rounded-2xl border border-gold/30 bg-white/60 p-6">
      <h3 class="font-display text-xl text-teak">{sources.reviewTitle}</h3>
      <p class="mt-3 text-sm text-ink/80">
        {sources.reviewIntro}{' '}
        <span class="text-teak font-semibold">{sources.reviewSourceLabel}</span>
        {' · '}
        {sources.reviewCopyright}
      </p>
      <p class="mt-3 text-sm text-ink/70">
        {sources.reviewLinkLabel}：<a href={sources.reviewLinkUrl} target="_blank" rel="noopener noreferrer" class="text-gold hover:underline">
          Google Maps ↗
        </a>
      </p>
    </div>

    <!-- 数据与事实来源 -->
    <div class="mt-8 rounded-2xl border border-gold/30 bg-white/60 p-6">
      <h3 class="font-display text-xl text-teak">{sources.factTitle}</h3>
      <p class="mt-3 text-sm text-ink/80">{sources.factText}</p>
    </div>

    <!-- 权威官方资料外链 -->
    <div class="mt-8 rounded-2xl border border-teak/30 bg-teak/5 p-6">
      <h3 class="font-display text-xl text-teak">{sources.officialTitle}</h3>
      <p class="mt-2 text-sm text-ink/75">{sources.officialNote}</p>
      <ul class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm">
        {sources.officialItems.map((it) => (
          <li>
            <a href={it.url} target="_blank" rel="noopener noreferrer" class="text-gold hover:underline inline-flex items-center gap-1">
              {it.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- 发现错误 -->
    <div class="mt-8 rounded-2xl border border-gold/30 bg-white/60 p-6">
      <h3 class="font-display text-xl text-teak">{sources.correctionTitle}</h3>
      <p class="mt-3 text-sm text-ink/80">{sources.correctionText}</p>
      <a
        href={sources.correctionMailto}
        class="mt-4 inline-flex items-center gap-2 text-teak border border-gold/50 px-5 py-2.5 rounded-full hover:bg-gold hover:text-teak transition-colors"
      >
        {sources.correctionCta} →
      </a>
    </div>

    <p class="mt-8 text-xs text-ink/50">© {sources.copyright}</p>
  </div>
</section>