---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const facilities = messages.facilities;
---

<section id="facilities" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{facilities.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{facilities.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{facilities.lead}</p>

    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {facilities.items.map((it: any) => (
        <div class="rounded-2xl border border-gold/30 bg-white/50 p-5 hover:border-gold hover:shadow-md transition">
          <div class="text-3xl" aria-hidden="true">{it.tag}</div>
          <h3 class="font-display text-lg text-teak mt-3">{it.title}</h3>
          <p class="mt-2 text-sm text-ink/75 leading-relaxed">{it.desc}</p>
        </div>
      ))}
    </div>

    <p class="mt-8 text-xs text-ink/50 max-w-3xl">{facilities.note}</p>
  </div>
</section>