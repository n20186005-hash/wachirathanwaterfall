---
/**
 * 实时天气 + 7 日预报（服务器端获取，模块级缓存 10 分钟）
 * 数据在服务端渲染时获取，前端仅展示结果。
 */
import { siteConfig } from '../config';
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const weather = messages.weather;

// ---- 模块级缓存（ isolate 生命周期内复用，10 分钟 ） ----
const CACHE_TTL = 10 * 60 * 1000;
const g: any = globalThis as any;

type WxData = {
  current: {
    temperature_2m: number;
    apparent_temperature: number;
    relative_humidity_2m: number;
    precipitation: number;
    weather_code: number;
    wind_speed_10m: number;
  };
  daily: {
    time: string[];
    weather_code: number[];
    temperature_2m_max: number[];
    temperature_2m_min: number[];
    precipitation_probability_max: number[];
    precipitation_sum: number[];
  };
};

async function loadWeather(): Promise<WxData | null> {
  const now = Date.now();
  if (g.__wachirathanWx && now - g.__wachirathanWx.ts < CACHE_TTL) {
    return g.__wachirathanWx.data;
  }
  try {
    const url =
      `https://api.open-meteo.com/v1/forecast` +
      `?latitude=${siteConfig.coords.lat}&longitude=${siteConfig.coords.lng}` +
      `&current=temperature_2m,apparent_temperature,relative_humidity_2m,precipitation,weather_code,wind_speed_10m` +
      `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum` +
      `&timezone=Asia%2FBangkok&forecast_days=7`;
    const res = await fetch(url, { signal: AbortSignal.timeout(6000) });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data: WxData = await res.json();
    g.__wachirathanWx = { ts: now, data };
    return data;
  } catch {
    return g.__wachirathanWx?.data ?? null;
  }
}

const data = await loadWeather();

// WMO 天气代码 → 本地化描述
const codeLabel = (code: number): string => {
  const c = weather.codes ?? {};
  return c[String(code)] ?? c['_'] ?? '—';
};

// 当地星期名
const localeMap: Record<Lang, string> = { th: 'th-TH', en: 'en-GB', zh: 'zh-CN' };
const dayName = (iso: string) => {
  const d = new Date(iso + 'T12:00:00');
  try {
    return new Intl.DateTimeFormat(localeMap[lang], { weekday: 'short' }).format(d);
  } catch {
    return iso.slice(5);
  }
};

// 带伞建议
const pop0 = data ? data.daily.precipitation_probability_max[0] ?? 0 : 0;
const umbrella = pop0 >= 50 ? weather.umbrellaYes : pop0 >= 20 ? weather.umbrellaMaybe : weather.umbrellaNo;
const umbrellaTone = pop0 >= 50 ? 'bg-sky-100 border-sky-300 text-sky-900' : pop0 >= 20 ? 'bg-amber-50 border-amber-300 text-amber-900' : 'bg-teal-50 border-teal-300 text-teal-900';

const fmt = (n: number) => Math.round(n);
---

<section id="weather" class="py-20 bg-gradient-to-b from-sky-50 to-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{weather.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{weather.heading}</h2>
    <p class="mt-4 max-w-2xl text-ink/80">{weather.lead}</p>

    {!data ? (
      <div class="mt-10 rounded-2xl border border-gold/30 bg-white/60 p-8 text-ink/60 max-w-xl">
        {weather.unavailable}
      </div>
    ) : (
      <>
        <!-- 当前实况 -->
        <div class="mt-10 grid lg:grid-cols-12 gap-6">
          <div class="lg:col-span-5 rounded-2xl bg-teak text-ivory p-8">
            <div class="flex items-start justify-between">
              <div>
                <div class="text-xs uppercase tracking-wider text-gold">{weather.now}</div>
                <div class="font-display text-6xl text-goldBright mt-2 leading-none">
                  {fmt(data.current.temperature_2m)}°C
                </div>
                <div class="mt-2 text-ivory/85">{codeLabel(data.current.weather_code)}</div>
              </div>
              <span class="chip border-gold/40 text-goldBright">{weather.live}</span>
            </div>

            <div class="grid grid-cols-2 gap-3 mt-8 text-sm">
              <div class="rounded-xl bg-teakDeep/70 p-3">
                <div class="text-ivory/60 text-xs">{weather.feels}</div>
                <div class="font-display text-xl text-ivory mt-0.5">{fmt(data.current.apparent_temperature)}°C</div>
              </div>
              <div class="rounded-xl bg-teakDeep/70 p-3">
                <div class="text-ivory/60 text-xs">{weather.humidity}</div>
                <div class="font-display text-xl text-ivory mt-0.5">{fmt(data.current.relative_humidity_2m)}%</div>
              </div>
              <div class="rounded-xl bg-teakDeep/70 p-3">
                <div class="text-ivory/60 text-xs">{weather.wind}</div>
                <div class="font-display text-xl text-ivory mt-0.5">{fmt(data.current.wind_speed_10m)} km/h</div>
              </div>
              <div class="rounded-xl bg-teakDeep/70 p-3">
                <div class="text-ivory/60 text-xs">{weather.rainToday}</div>
                <div class="font-display text-xl text-ivory mt-0.5">{fmt(pop0)}%</div>
              </div>
            </div>

            <div class={`mt-5 rounded-xl border p-4 text-sm font-medium ${umbrellaTone}`}>
              ☂ {umbrella}
            </div>
          </div>

          <!-- 7 日预报 -->
          <div class="lg:col-span-7 rounded-2xl border border-gold/30 bg-white/60 p-6">
            <h3 class="font-display text-xl text-teak">{weather.week}</h3>
            <div class="mt-4 divide-y divide-gold/15">
              {data.daily.time.map((iso, i) => (
                <div class="flex items-center gap-3 py-2.5 text-sm">
                  <span class={`w-16 font-semibold ${i === 0 ? 'text-gold' : 'text-teak'}`}>{i === 0 ? weather.today : dayName(iso)}</span>
                  <span class="w-24 text-ink/70 whitespace-nowrap">{codeLabel(data.daily.weather_code[i])}</span>
                  <div class="flex-1 hidden sm:block h-1.5 rounded-full bg-teal/15 overflow-hidden">
                    <div class="h-full bg-sky-400/70" style={`width:${data.daily.precipitation_probability_max[i] ?? 0}%`}></div>
                  </div>
                  <span class="w-12 text-right text-sky-600 whitespace-nowrap">{fmt(data.daily.precipitation_probability_max[i] ?? 0)}%</span>
                  <span class="w-24 text-right whitespace-nowrap">
                    <span class="text-teak font-semibold">{fmt(data.daily.temperature_2m_max[i])}°</span>
                    <span class="text-ink/45 ml-1">{fmt(data.daily.temperature_2m_min[i])}°</span>
                  </span>
                </div>
              ))}
            </div>
            <p class="mt-4 text-xs text-ink/50">{weather.note}</p>
          </div>
        </div>
      </>
    )}
  </div>
</section>